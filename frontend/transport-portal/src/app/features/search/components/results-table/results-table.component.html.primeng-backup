<div class="results-table-container">
  <p-table
    #dt
    [value]="vehicles"
    [loading]="loading"
    styleClass="p-datatable-striped"
    responsiveLayout="scroll"
    dataKey="transport_id"
  >
    <ng-template pTemplate="caption">
      <div class="table-header">
        <h5>{{ totalRecords }} aircraft found</h5>
      </div>
    </ng-template>

    <ng-template pTemplate="header">
      <tr>
        <th
          pSortableColumn="registration_id"
          (click)="onSort('registration_id')"
        >
          Registration <p-sortIcon field="registration_id"></p-sortIcon>
        </th>
        <th pSortableColumn="manufacturer" (click)="onSort('manufacturer')">
          Manufacturer <p-sortIcon field="manufacturer"></p-sortIcon>
        </th>
        <th pSortableColumn="model" (click)="onSort('model')">
          Model <p-sortIcon field="model"></p-sortIcon>
        </th>
        <th pSortableColumn="year" (click)="onSort('year')">
          Year <p-sortIcon field="year"></p-sortIcon>
        </th>
        <th pSortableColumn="category" (click)="onSort('category')">
          Type <p-sortIcon field="category"></p-sortIcon>
        </th>
        <th
          pSortableColumn="location.state_province"
          (click)="onSort('location.state_province')"
        >
          State <p-sortIcon field="location.state_province"></p-sortIcon>
        </th>
        <th>Actions</th>
      </tr>
      <tr class="filter-row">
        <th>
          <input
            pInputText
            type="text"
            placeholder="Filter..."
            [value]="filterRegistration"
            (input)="onFilterChange('registration', $any($event.target).value)"
            class="filter-input"
          />
        </th>
        <th>
          <input
            pInputText
            type="text"
            placeholder="Filter..."
            [value]="filterManufacturer"
            (input)="onFilterChange('manufacturer', $any($event.target).value)"
            class="filter-input"
          />
        </th>
        <th>
          <input
            pInputText
            type="text"
            placeholder="Filter..."
            [value]="filterModel"
            (input)="onFilterChange('model', $any($event.target).value)"
            class="filter-input"
          />
        </th>
        <th>
          <div class="year-filter">
            <input
              pInputText
              type="number"
              placeholder="Min"
              [value]="filterYearMin || ''"
              (input)="onFilterChange('yearMin', $any($event.target).value)"
              class="filter-input filter-input-small"
            />
            <input
              pInputText
              type="number"
              placeholder="Max"
              [value]="filterYearMax || ''"
              (input)="onFilterChange('yearMax', $any($event.target).value)"
              class="filter-input filter-input-small"
            />
          </div>
        </th>
        <th>
          <input
            pInputText
            type="text"
            placeholder="Filter..."
            [value]="filterCategory"
            (input)="onFilterChange('category', $any($event.target).value)"
            class="filter-input"
          />
        </th>
        <th>
          <input
            pInputText
            type="text"
            placeholder="Filter..."
            [value]="filterState"
            (input)="onFilterChange('state', $any($event.target).value)"
            class="filter-input"
          />
        </th>
        <th></th>
      </tr>
    </ng-template>

    <ng-template pTemplate="body" let-vehicle>
      <tr>
        <td>{{ vehicle.registration_id || "N/A" }}</td>
        <td>{{ vehicle.manufacturer || "Unknown" }}</td>
        <td>{{ vehicle.model || "Unknown" }}</td>
        <td>{{ vehicle.year || "N/A" }}</td>
        <td>{{ vehicle.category || "N/A" }}</td>
        <td>{{ vehicle.location?.state_province || "N/A" }}</td>
        <td>
          <button
            pButton
            type="button"
            label="View Details"
            class="p-button-sm p-button-text"
            (click)="onViewDetails(vehicle.transport_id)"
          ></button>
        </td>
      </tr>
    </ng-template>

    <ng-template pTemplate="emptymessage">
      <tr>
        <td colspan="7" class="no-results">
          <p>No vehicles found matching your criteria.</p>
          <p class="suggestion">
            Try adjusting your filters or reset to see all results.
          </p>
        </td>
      </tr>
    </ng-template>
  </p-table>
</div>
